{
  "name": "zotero-quicklex",
  "version": "0.2.1",
  "private": true,
  "description": "Offline English–Chinese and Russian–Chinese word lookup for Zotero on Windows and macOS",
  "scripts": {
    "dictionary": "python scripts/build_dictionary.py",
    "build": "python scripts/package.py",
    "test": "node --test tests/core.test.cjs tests/runtime.test.cjs tests/manifest.test.cjs tests/russian.test.cjs",
    "benchmark": "node scripts/benchmark.cjs"
  }
}
